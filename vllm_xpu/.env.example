# ============================================================================
# .env.example — vLLM settings for vllm_xpu/compose.yaml (Arc Pro B60)
# ============================================================================
# Copy to `.env` in THIS folder (gitignored), then uncomment a variable to
# override. Compose auto-reads `.env` from the compose file's folder — no
# extra flags needed. From this folder:
#   cp .env.example .env
#   docker compose config    # preview the rendered command
#   docker compose up -d     # apply (recreates the container if it changed)
#
# Every variable is VALUE-ONLY — flag names live in compose.yaml's command,
# values come from here.
#   * Section 1: flags already in the command. Uncomment + edit to override;
#     the compose defaults equal the validated B60 recipe, so without a `.env`
#     (or with everything commented) nothing changes.
#   * Section 2: optional flags NOT in the command. Setting the variable alone
#     does NOTHING — each entry shows the exact line to ADD to the command in
#     compose.yaml to wire it up.
#
# Only flags relevant to the Arc Pro B60/B70 (single GPU, 24/32 GB) are listed.
# Verified against vLLM v0.21.0 (intel/vllm:0.21.0-ubuntu24.04).

# ----------------------------------------------------------------------------
# 1. FLAGS IN THE COMMAND (defaults = the validated B60 recipe)
# ----------------------------------------------------------------------------

# HuggingFace model to serve. Must fit the card: ~22.7 GiB usable on the B60
# (e.g. openai/gpt-oss-20b MXFP4 ~13.7 GiB; Qwen3-30B-A3B-GPTQ-Int4 ~17 GiB).
# Swapping the model requires swapping the parsers below to match.
# Default: openai/gpt-oss-20b
#VLLM_MODEL=openai/gpt-oss-20b

# Model name published on /v1/models (what gateways/UIs must request).
# Default: gpt-oss-20b
#VLLM_SERVED_MODEL_NAME=gpt-oss-20b

# Context window in tokens. Sizes the reserved KV pool on the card, so it is
# VRAM-coupled. Default is now the model's native max (131072 / 128k): it fits
# the 24 GB B60 because vLLM V1 chunked prefill bounds activation + compile
# buffers by chunk size (not context length), and gpt-oss's sliding-window(128)
# layers halve per-request KV cost — the measured pool held 179,589 tokens =
# 1.37x a single 128k request even at the old 0.75 util. Lower it (e.g. 65536)
# only to reclaim pool for concurrency; do NOT raise the util to compensate.
# Default: 131072
#VLLM_MAX_MODEL_LEN=131072

# Fraction of VRAM vLLM budgets for weights + KV pool. 0.80 is the default now
# that the desktop is OFF the B60 (displays on the AMD iGPU): no compositor
# competing for VRAM, and an engine OOM just restarts the container instead of
# freezing the machine. torch.compile/Inductor buffers are NOT capped by this
# value — 0.86 filled the card to 22.67/22.71 GiB -> OOM-edge instability, so
# treat 0.86 as a hard ceiling and stay clear of it. (0.75 was the prior
# display-shared default.)
# Default: 0.80
#VLLM_GPU_MEMORY_UTILIZATION=0.80

# Reasoning parser — MODEL-COUPLED, not a preference. gpt-oss needs
# openai_gptoss (exposes the harmony analysis channel as message.reasoning);
# Qwen3-family models need qwen3.
# Default: openai_gptoss
#VLLM_REASONING_PARSER=openai_gptoss

# Tool-call parser — MODEL-COUPLED. gpt-oss needs openai; Qwen3 needs hermes.
# Default: openai
#VLLM_TOOL_CALL_PARSER=openai

# --host 0.0.0.0 / --port 8000 / --enable-auto-tool-choice are fixed in the
# compose file (port is also baked into ports: and the healthcheck).

# ----------------------------------------------------------------------------
# 2. OPTIONAL FLAGS — not in the command; setting the variable alone does
#    NOTHING. To use one: add its line to `command:` in compose.yaml (any
#    position before the end works), then tune the value here.
# ----------------------------------------------------------------------------

# Max concurrent sequences scheduled per step. The engine default targets
# server farms; on a 22.7 GiB single-user box, lowering it shrinks activation
# buffers and leaves more real headroom. Verify actual effect on this build.
# vLLM default: engine-chosen (~256)
# ADD to compose.yaml:   --max-num-seqs ${VLLM_MAX_NUM_SEQS:-16}
#VLLM_MAX_NUM_SEQS=16

# Max tokens processed per engine step (prefill chunk size). Bigger = faster
# long-prompt ingest (RAG), at the cost of peak activation memory on the card.
# vLLM default: engine-chosen (~8192)
# ADD to compose.yaml:   --max-num-batched-tokens ${VLLM_MAX_NUM_BATCHED_TOKENS:-16384}
#VLLM_MAX_NUM_BATCHED_TOKENS=16384

# KV cache dtype. fp8 halves KV memory -> roughly double the context/
# concurrency per GiB of pool. UNPROVEN on the Arc/XPU build — boot-test and
# check output quality before adopting (same caution as the old FP8 weight bug).
# vLLM default: auto (model dtype)
# ADD to compose.yaml:   --kv-cache-dtype ${VLLM_KV_CACHE_DTYPE:-fp8}
#VLLM_KV_CACHE_DTYPE=fp8

# Give the KV pool an EXPLICIT byte size instead of the util fraction —
# sidesteps fraction maths, useful on this XPU build precisely because of the
# uncapped-compile-buffer gotcha above. (If you add this, consider removing
# --gpu-memory-utilization from the command — they overlap.)
# vLLM default: unset (sized via the util fraction)
# ADD to compose.yaml:   --kv-cache-memory-bytes ${VLLM_KV_CACHE_MEMORY_BYTES:-4000000000}
#VLLM_KV_CACHE_MEMORY_BYTES=4000000000

# Online (load-time) quantization for models that are NOT pre-quantized.
# The Arc use case: dynamic FP8/INT4 to fit a bigger BF16 checkpoint into
# 24 GB during a model swap. Do NOT set for gpt-oss-20b (already MXFP4) or
# for *-GPTQ/-AWQ checkpoints (already quantized).
# vLLM default: unset (checkpoint's native format)
# ADD to compose.yaml:   --quantization ${VLLM_QUANTIZATION:-fp8}
#VLLM_QUANTIZATION=fp8

# ----------------------------------------------------------------------------
# BOOLEAN FLAGS (no value, so no variable) — add the flag itself to the
# command in compose.yaml when wanted:
#   --enforce-eager             disable torch.compile (MANDATORY on the
#                               llm-scaler fork for gpt-oss; optional here —
#                               slower, but skips compile warm-up/buffers)
#   --no-enable-prefix-caching  disable KV reuse across shared prompt prefixes
#                               (ON by default; leave on for chat/RAG)
# ----------------------------------------------------------------------------
