# vllm_openai_xpu/.env.example — copy to `.env` (auto-read by Compose, gitignored).
#
# This engine alternates between TWO validated models. Uncomment EXACTLY ONE of
# the two blocks below, then force-recreate:
#
#   docker compose -f vllm_openai_xpu/compose.yaml up -d --force-recreate
#
# --force-recreate is mandatory: vLLM bakes its CLI args into the container, so
# a plain `up -d` silently keeps the previous model's arguments.
#
# !! SWITCH ALL VARIABLES IN A BLOCK TOGETHER. They are not independent:
#      - gemma-4 weights (16.93 GiB) + gpt-oss's KV (8.0 GiB) > 22.33 GiB free
#        => boots straight into an OOM.
#      - gpt-oss weights (12.87 GiB) + gemma-4's KV (4.25 GiB) boots fine but
#        strands ~5 GiB of the card and shrinks the pool for no reason.
#      - a mismatched reasoning/tool parser does NOT crash; it silently yields
#        an empty reasoning field or no tool_calls. Easy to miss.
#    Leaving a block fully commented is always safe: every variable falls back
#    to the compose default, which is the gpt-oss-20b block.
#
# !! SINGLE GPU — `down` the other engine folder first (vllm_xpu/ or scaler/).

# ════════════════════════════════════════════════════════════════════════════
# BLOCK A — gpt-oss-20b   (compose default; best for long / cold contexts)
# ════════════════════════════════════════════════════════════════════════════
# Measured on this B60: 12.87 GiB weights, 83.2 tok/s, 338,928-token KV pool
# = 2.59x concurrency @128k. Reasoning is ALWAYS on; it has no opt-in flag, so
# VLLM_DEFAULT_CHAT_TEMPLATE_KWARGS is left unset here (it would be a no-op).
# Better choice for coding-CLI traffic via LiteLLM/Bifrost, because its prefill
# stays linear at large context — see Block B's warning.
#
#VLLM_MODEL=openai/gpt-oss-20b
#VLLM_SERVED_MODEL_NAME=gpt-oss-20b
#VLLM_REASONING_PARSER=openai_gptoss
#VLLM_TOOL_CALL_PARSER=openai
#VLLM_MAX_MODEL_LEN=131072
#VLLM_KV_CACHE_MEMORY=8603448832

# ════════════════════════════════════════════════════════════════════════════
# BLOCK B — gemma-4-26B-A4B-it, offline int4  (newer model, vision-capable)
# ════════════════════════════════════════════════════════════════════════════
# Measured on this B60: 16.93 GiB weights, ~50 tok/s decode (~43-44 tok/s with
# reasoning on), TTFT ~56 ms, 78,433-token KV pool = 2.39x concurrency @32k.
# ~48.5k is the hard single-request ceiling at this KV size; 65536 fails to boot
# (needs 4.57 GiB).
#
# CHECKPOINT CONSTRAINT: must be int4-symmetric, group_size 32 or channelwise.
# The XPU expert kernel (XPUExpertsWNA16) accepts only those two schemes, so the
# smaller and more popular group-64 builds (dhruvil237/..., amd/...) are
# REJECTED at load despite being ~2 GiB lighter.
#
# ⚠ PREFILL IS QUADRATIC, and it is NOT tunable. gemma-4 has heterogeneous head
# dims (sliding 256 / full-attention 512); XPU has no FA4 kernel, so TRITON_ATTN
# is forced at config level and VLLM_ATTENTION_BACKEND is ignored. Measured cold
# prefill: 2.4k tok 2.2 s | 4.8k 5.6 s | 9.6k 19.4 s | 19.2k 80.8 s (2x tokens
# => 4x time). Raising --max-num-batched-tokens buys only ~15% and inflates the
# KV requirement enough to break a 64k boot.
#   Prefix caching hides this for repeat/growing prompts: 26.9 s cold -> 0.38 s
#   warm (71x). So conversation and growing context are fine; a large COLD
#   context (fresh RAG doc, big paste) is where it hurts.
#
VLLM_MODEL=reinforce20001/gemma4-26b-a4b-it-qat-w4a16-ct
VLLM_SERVED_MODEL_NAME=gemma-4-26b-a4b
VLLM_REASONING_PARSER=gemma4
VLLM_TOOL_CALL_PARSER=gemma4
VLLM_MAX_MODEL_LEN=32768
VLLM_KV_CACHE_MEMORY=4563402752

# gemma-4's reasoning is OPT-IN (its chat template defaults enable_thinking to
# false), unlike gpt-oss which always reasons. This makes it on-by-default
# server-side, so clients need no special field. VERIFIED on this box:
#   unset/null -> ./smoke.sh reasoning check FAILS, reasoning len 0
#   set as below -> ./smoke.sh PASSES with no client flag, reasoning len 738
# A request can still override it BOTH ways, which is also verified:
#   "chat_template_kwargs": {"enable_thinking": false}   -> suppresses it
# Costs ~15% throughput while reasoning (43-44 vs 50.6 tok/s), and reasoning
# eats the token budget first — allow 1500+ max_tokens or you get no answer.
# Comment this line out to go back to per-request opt-in.
VLLM_DEFAULT_CHAT_TEMPLATE_KWARGS={"enable_thinking":true}

# ════════════════════════════════════════════════════════════════════════════
# After any switch
# ════════════════════════════════════════════════════════════════════════════
# The served model name changes with the block, so DOWNSTREAM BREAKS until it is
# repointed: LiteLLM (:4000) and Bifrost (:4010) map to a fixed model id and
# will 404 against the other block. Either repoint them, or add the old name as
# a second --served-model-name alias in compose.yaml.
#
# Verify the swap. Both scripts auto-detect the served model when MODEL is unset,
# and THINKING is tri-state (auto = report what the DEPLOYED default does):
#   ./smoke.sh              # ALL PASS on both blocks as configured above
#   THINKING=1 ./smoke.sh   # force reasoning on  -> expects a trace
#   THINKING=0 ./smoke.sh   # force reasoning off -> expects it SUPPRESSED
#   ./bench.sh 400          # ~83 tok/s gpt-oss, ~50 tok/s gemma (no reasoning)
#   ./bench.sh 1500         # with reasoning on, need the larger budget
#
# ════════════════════════════════════════════════════════════════════════════
# Engine knobs — shared by both blocks, rarely changed
# ════════════════════════════════════════════════════════════════════════════
# MUST stay 0 while VLLM_USE_V2_MODEL_RUNNER=1: 1 segfaults at boot inside the
# SYCL persistent code-cache read. Costs a kernel rebuild each boot (~70 s).
#SYCL_CACHE_PERSISTENT=0

# Single-GPU-only upstream, defaults off. Measured a NO-OP under --enforce-eager.
#VLLM_XPU_ENABLE_XPU_GRAPH=0

# Upstream default from 0.29.0 on; measured faster and leaner here. 0 pins V1.
# Integer only — a blank value crashes at boot.
#VLLM_USE_V2_MODEL_RUNNER=1

# Empty = anonymous. Only needed for gated repos; neither block above is gated.
#HF_TOKEN=
