# vllm_openai_xpu/.env.example — copy to `.env` (gitignored, read by Compose).
#
# How to use it:
#   1. Keep EXACTLY ONE model block below uncommented.
#   2. Inside that block, keep the KV line for your card (B60 = 24 GB,
#      B70 = 32 GB). Values are explained in ../INTEL_ARC_B60.md and
#      ../INTEL_ARC_B70.md.
#   3. Apply with `docker compose up -d`. `docker compose restart` does NOT
#      pick up an edit.
#
# Switch a whole block, never single lines. Each block sets every
# model-specific variable, because carrying one across fails badly:
#   - VLLM_KV_CACHE_MEMORY is absolute bytes. Too big for the next model's
#     weights => boot OOM. Too small => memory left unused.
#   - VLLM_EAGER_FLAG: gpt-oss on a B60 needs --enforce-eager, or its boot dies.
#   - VLLM_TEXT_ONLY_FLAG: carrying gemma-4's --language-model-only turns image
#     input off for the next model too.
#   - VLLM_SPECULATIVE_CONFIG: gemma-4's names Google's draft model, and
#     Qwen3.8's uses the MTP head only its checkpoint ships. Neither fits any
#     other model, so gpt-oss's block sets it to null.
#   - A wrong reasoning or tool parser does not crash. You just get an empty
#     reasoning field or no tool_calls.
# With every block commented out, compose falls back to gpt-oss-20b on the
# B60's values.
#
# One GPU: `docker compose down` in vllm_xpu/ or scaler/ first.
# Details for every variable: ./README.md "Configuration — .env".

# ════════════════════════════════════════════════════════════════════════════
# BLOCK A — gpt-oss-20b
# ════════════════════════════════════════════════════════════════════════════
# 12.87 GiB of weights. Always reasons, there is no off switch. Prefill stays
# fast at any length. Not measured on the B70 yet: the B60 value should boot
# there but leaves memory unused.
#
#VLLM_MODEL=openai/gpt-oss-20b
#VLLM_SERVED_MODEL_NAME=gpt-oss-20b
#VLLM_REASONING_PARSER=openai_gptoss
#VLLM_TOOL_CALL_PARSER=openai
#VLLM_MAX_MODEL_LEN=131072
#VLLM_DEFAULT_CHAT_TEMPLATE_KWARGS=null
#VLLM_ATTN_BACKEND=auto
#VLLM_TEXT_ONLY_FLAG=--no-language-model-only
#VLLM_SPECULATIVE_CONFIG=null
# Eager is required with the B60's 8.0 GiB KV value.
#VLLM_EAGER_FLAG=--enforce-eager
# Arc Pro B60: 8.0 GiB -> 338,928 tokens (2.59x)
#VLLM_KV_CACHE_MEMORY=8603448832

# ════════════════════════════════════════════════════════════════════════════
# BLOCK B — gemma-4-26B-A4B-it, offline int4
# ════════════════════════════════════════════════════════════════════════════
# MoE, vision-capable. The checkpoint must be int4 symmetric with group size
# 32 (or channelwise); other builds are rejected at load.
# See ./README.md "gemma-4 in depth".
#
# Checkpoint, draft model and KV value go together, one set per card.
# Arc Pro B70: adeepv with Google's draft model (decode about 1.7x faster),
# 9.5 GiB -> 356,893 tokens (2.72x). Without the draft: draft line null and
# 11274289152 (10.5 GiB -> 394,408 tokens). ./README.md "Faster decode with
# a draft model"
VLLM_MODEL=adeepv/gemma-4-26B-A4B-it-W4A16-vLLM
VLLM_SPECULATIVE_CONFIG={"model":"google/gemma-4-26B-A4B-it-qat-q4_0-unquantized-assistant","num_speculative_tokens":3}
VLLM_KV_CACHE_MEMORY=10200547328
# Arc Pro B60: reinforce20001, no draft, 4.25 GiB -> 152,592 tokens (1.16x),
# Triton
#VLLM_MODEL=reinforce20001/gemma4-26b-a4b-it-qat-w4a16-ct
#VLLM_SPECULATIVE_CONFIG=null
#VLLM_KV_CACHE_MEMORY=4563402752
#
VLLM_SERVED_MODEL_NAME=gemma-4-26b-a4b
VLLM_REASONING_PARSER=gemma4
VLLM_TOOL_CALL_PARSER=gemma4
VLLM_MAX_MODEL_LEN=131072
# gemma-4's template leaves reasoning off; this turns it on for every request.
# Set it to null to leave it to each request.
VLLM_DEFAULT_CHAT_TEMPLATE_KWARGS={"enable_thinking":true}
VLLM_EAGER_FLAG=--no-enforce-eager
# Intel's attention kernel: prefill 16-28x faster, decode +16%, but NO image
# input. Set auto and --no-language-model-only to get Triton and images back.
VLLM_ATTN_BACKEND=FLASH_ATTN
VLLM_TEXT_ONLY_FLAG=--language-model-only

# ════════════════════════════════════════════════════════════════════════════
# BLOCK C — Qwen3.8-27B, offline int4
# ════════════════════════════════════════════════════════════════════════════
# Dense, vision-capable, thinks by default. Its attention heads are size 256,
# so Intel's kernel takes it with images still working.
# See ./README.md "Qwen3.8-27B".
#
# Model, KV value and MTP go together. Keep one of the two sets:
# Fast, Arc Pro B70: MTP + an FP8 output layer -> 65.8 tok/s greedy,
# 8.0 GiB -> 208,093 tokens (1.59x). Same answers as the plain set.
# Make the FP8 copy first: ./README.md "Faster decode: MTP and an FP8
# output layer".
#VLLM_MODEL=/cache/huggingface/local/Qwen3.8-27B-INT4-fp8head
#VLLM_KV_CACHE_MEMORY=8603448832
#VLLM_SPECULATIVE_CONFIG={"method":"mtp","num_speculative_tokens":3}
# Plain, Arc Pro B70: 32.9 tok/s, 8.0 GiB -> 244,270 tokens (1.86x), an
# 18.8k-token prompt in 12.8 s (Triton: 29.7 tok/s and 283 s).
#VLLM_MODEL=RedHatAI/Qwen3.8-27B-INT4
#VLLM_KV_CACHE_MEMORY=8603448832
#VLLM_SPECULATIVE_CONFIG=null
# Arc Pro B60: not tested. 17.56 GiB of weights leave too little for 128k.
#
#VLLM_SERVED_MODEL_NAME=qwen3.8-27b
#VLLM_REASONING_PARSER=qwen3
#VLLM_TOOL_CALL_PARSER=qwen3_coder
#VLLM_MAX_MODEL_LEN=131072
#VLLM_DEFAULT_CHAT_TEMPLATE_KWARGS=null
#VLLM_EAGER_FLAG=--no-enforce-eager
#VLLM_ATTN_BACKEND=FLASH_ATTN
#VLLM_TEXT_ONLY_FLAG=--no-language-model-only

# ════════════════════════════════════════════════════════════════════════════
# After a switch
# ════════════════════════════════════════════════════════════════════════════
# The served name changes with the block, so any gateway or client that asks
# for the old name gets a 404 until you update its model mapping. Then check:
#   ./smoke.sh              # run from the repo root; ALL PASS on every block

# ════════════════════════════════════════════════════════════════════════════
# Engine settings — shared by all blocks, rarely changed
# ════════════════════════════════════════════════════════════════════════════
# Must stay 0 with the V2 runner: 1 segfaults at boot.
#SYCL_CACHE_PERSISTENT=0
#
# V2 model runner, upstream's default. 0 pins V1. Integer only.
#VLLM_USE_V2_MODEL_RUNNER=1
#
# XPU graph. +0.5% for 1.54 GiB on the B60, nothing to gain on the B70.
#VLLM_XPU_ENABLE_XPU_GRAPH=0

# ----------------------------------------------------------------------------
# WHERE THE MODELS LIVE (defaults = Docker's named volume, run as root)
# ----------------------------------------------------------------------------
# To keep them in a folder you own, set BOTH lines below. Use the same values
# in every engine folder's .env, because the engines share the weights.

# Host folder for the weights. Must be an absolute path; `~` isn't expanded.
#HF_CACHE=/home/you/models/hf

# User the engine runs as: your `id -u`:`id -g`. The default 0:0 is root, so
# anything it downloads into your folder would be owned by root again. The
# GPU doesn't need root; group_add in compose.yaml passes render and video.
#VLLM_USER=1000:1000

# Empty = anonymous. Only needed for gated repos; none of the blocks above is.
#HF_TOKEN=
