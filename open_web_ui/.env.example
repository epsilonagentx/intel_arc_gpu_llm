# open_web_ui/.env.example — settings for open_web_ui/compose.yaml.
#
# Copy to `.env` in THIS folder (gitignored), then uncomment what you want to
# change. Compose reads it on its own. From this folder:
#   cp .env.example .env
#   docker compose config    # preview what Compose will run
#   docker compose up -d     # apply (`restart` does NOT pick up an edit)
#
# Without a `.env`, or with every line commented, nothing changes.
#
# The names carry an OPEN_WEBUI_ prefix on purpose. Compose lets a variable
# from your shell override this file, and a shell often exports its own
# OPENAI_API_KEY; with plain names that key would be sent to your vLLM.

# Image. Leave it commented to follow the version this repo pins; a value here
# keeps you on it even after the repo moves on.
#OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui:v0.12.5

# Host port for the UI. Without an address it listens on every interface.
# Put your host's LAN address in front to listen on that network only, e.g.
# 192.168.x.x:3000, and open the port to your subnet in the firewall. The UI
# is then reached at that address, not at localhost.
#OPEN_WEBUI_PORT=3000

# Where the vLLM engine is. The default reaches whichever engine publishes
# :8000 on this host; for another machine use http://<vllm-host>:8000/v1.
#OPEN_WEBUI_API_BASE_URL=http://host.docker.internal:8000/v1

# Key sent to vLLM. vLLM takes any value unless it runs with --api-key.
#OPEN_WEBUI_API_KEY=EMPTY

# Login. Off is for local testing only; set true before anyone else can reach
# the UI.
#OPEN_WEBUI_AUTH=false

# Whether visitors can create an account (only matters with auth on).
#OPEN_WEBUI_SIGNUP=false

# Which web origins may call the UI's API. * is Open WebUI's default and logs
# a warning; for real use put your own origin, e.g. https://chat.example.com
#OPEN_WEBUI_CORS_ALLOW_ORIGIN=*

# Open WebUI saves the URL, key and signup values in its database on first
# start, then ignores them here; you change them in its Admin settings. false
# makes it read this file on every start instead, and settings changed in the
# Admin panel are lost on restart.
#OPEN_WEBUI_PERSISTENT_CONFIG=true
